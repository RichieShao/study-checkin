{
  "version": 2,
  "installCommand": "npm install",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|index\\.html|styles\\.css|app\\.js|favicon).*)",
      "destination": "/index.html"
    }
  ]
}
